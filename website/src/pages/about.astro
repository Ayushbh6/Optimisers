---
import Shell from '../layouts/Shell.astro';
import ExternalArrow from '../components/ExternalArrow.astro';
import {founders} from '../content/studio';
---
<Shell title="About us" section="About">
  <section class="page about-page" aria-labelledby="about-title">
    <div class="page-heading"><div><p class="eyebrow">02 / The people behind the work</p><h1 id="about-title">Two perspectives.<br />A shared way of thinking.</h1></div><p class="intro-copy">Understand the problem.<br />Question the assumptions.<br />Build something that helps.</p></div>
    <div class="founders">{founders.map(founder => <article class="founder"><div class="portrait"><img src={founder.image} alt={founder.name} width="600" height="800" /></div><div class="founder-copy"><p class="eyebrow">{founder.role}</p><h2>{founder.short}<span>{founder.name.replace(founder.short === 'Max' ? 'Maximilian ' : 'Ayush ', '')}</span></h2><p>{founder.description}</p><p class="qualification">{founder.background}</p><div class="founder-links"><a class="text-link" href={`mailto:${founder.email}`}>Email <ExternalArrow /></a><a class="text-link" href={founder.github} target="_blank" rel="noopener noreferrer">GitHub <ExternalArrow /></a></div></div></article>)}</div>
  </section>
</Shell>
